{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "npx expo start",
    "expo:customer": "cross-env EXPO_PUBLIC_APP_MODE=customer npx expo start",
    "expo:driver": "cross-env EXPO_PUBLIC_APP_MODE=driver npx expo start",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "start": "npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "android": "expo run:android",
    "android:driver": "cross-env EXPO_PUBLIC_APP_MODE=driver expo run:android",
    "android:driver:release": "cross-env EXPO_PUBLIC_APP_MODE=driver expo run:android --variant release",
    "ios": "expo run:ios",
    "build:customer": "eas build --profile customer --platform android",
    "build:driver": "eas build --profile driver --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@googlemaps/google-maps-services-js": "^3.4.2",
